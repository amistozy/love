import {
  "amistozy/love",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/async/stdio",
}

supported_targets = "-all+native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "stub.c" ],
  targets: { "tty.mbt": [ "native" ] },
)
